[Unit]
Description=NewType CRM API
After=network.target

[Service]
Type=simple
User=crm
Group=crm
WorkingDirectory=/opt/newtype-crm
EnvironmentFile=/etc/newtype-crm/crm.env
ExecStart=/usr/bin/node /opt/newtype-crm/server/index.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/newtype-crm /var/backups/newtype-crm

[Install]
WantedBy=multi-user.target
